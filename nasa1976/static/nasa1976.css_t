/* NASA 1976 — Sphinx theme
   After NHB 1430.2, NASA Graphics Standards Manual, January 1976.
   Flush left, ragged right. Two colours. Rules, not boxes. */

:root {
  --nasa-red: {{ theme_accent_color }};
  --nasa-gray: #7e7a6b;
  --nasa-blue: #0032a0;

  --nasa-bg: #ffffff;
  --nasa-paper: #f4f3f0;
  --nasa-text: #000000;
  --nasa-ink: #1a1a1a;
  --nasa-mute: #6e6e68;
  --nasa-rule: #111111;
  --nasa-hairline: #c9c9c4;

  --nasa-font: "Futura", "Futura PT", "Century Gothic", "URW Gothic",
               "Avenir Next", "Trebuchet MS", system-ui, sans-serif;
  --nasa-mono: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas,
               "DejaVu Sans Mono", monospace;

  --nasa-margin-col: 15.5rem;
  --nasa-measure: 44rem;
  --nasa-gutter: 2.75rem;
  --nasa-pad: 2.25rem;
}

@media (prefers-color-scheme: dark) {
  :root {
    --nasa-bg: #000000;
    --nasa-paper: #141414;
    --nasa-text: #ffffff;
    --nasa-ink: #e8e8e6;
    --nasa-mute: #9a9a94;
    --nasa-rule: #ffffff;
    --nasa-hairline: #3a3a3a;
  }
}

/* ---------- reset-ish ---------- */

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: var(--nasa-bg);
  color: var(--nasa-ink);
  font-family: var(--nasa-font);
  /* Futura has a small x-height; the manual warns to compensate on size. */
  font-size: 16.5px;
  line-height: 1.6;
  text-align: left;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; height: auto; }

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--nasa-red);
  color: #fff;
  padding: 0.6rem 1rem;
  z-index: 20;
}
.skip-link:focus { left: 0; }

:focus-visible {
  outline: 2px solid var(--nasa-red);
  outline-offset: 2px;
}

/* ---------- masthead ---------- */

.nasa-masthead {
  border-bottom: 1px solid var(--nasa-rule);
  background: var(--nasa-bg);
}

.nasa-masthead-inner {
  max-width: calc(var(--nasa-margin-col) + var(--nasa-gutter) + var(--nasa-measure) + var(--nasa-pad));
  margin: 0 auto;
  padding: 1.5rem var(--nasa-pad) 1.1rem;
}

.nasa-program {
  margin: 0 0 0.35rem;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--nasa-mute);
}

.nasa-sitetitle {
  margin: 0;
  font-size: 1.28rem;
  font-weight: 700;
  line-height: 1.2;
}

.nasa-sitetitle a {
  color: var(--nasa-text);
  text-decoration: none;
  background: none;
  border-bottom: 0;
}

.nasa-release {
  margin-left: 0.75rem;
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--nasa-mute);
}

/* ---------- page grid ---------- */

.nasa-page {
  display: grid;
  grid-template-columns: var(--nasa-margin-col) minmax(0, 1fr);
  column-gap: var(--nasa-gutter);
  max-width: calc(var(--nasa-margin-col) + var(--nasa-gutter) + var(--nasa-measure) + var(--nasa-pad));
  margin: 0 auto;
  padding: 0 var(--nasa-pad) 4rem;
  align-items: start;
}

.nasa-body {
  min-width: 0;
  padding-top: 2.5rem;
  max-width: var(--nasa-measure);
}

/* ---------- margin column ---------- */

.nasa-margin {
  padding-top: 2.5rem;
  position: sticky;
  top: 0;
  max-height: 100vh;
  overflow-y: auto;
  font-size: 0.87rem;
}

.nasa-logo { margin: 0 0 1.25rem; }

.nasa-margin h3 {
  margin: 0 0 0.5rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid var(--nasa-rule);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--nasa-text);
}

.nasa-margin ul {
  margin: 0 0 1.75rem;
  padding: 0;
  list-style: none;
}

.nasa-margin li { margin: 0; }

.nasa-margin li a {
  display: block;
  padding: 0.22rem 0;
  color: var(--nasa-ink);
  text-decoration: none;
  border: 0;
}

.nasa-margin li a:hover { color: var(--nasa-red); }

.nasa-margin li.current > a,
.nasa-margin li a.current {
  color: var(--nasa-red);
  font-weight: 700;
}

.nasa-margin ul ul {
  margin: 0 0 0.35rem;
  padding-left: 0.9rem;
}

.nasa-margin ul ul a { font-size: 0.95em; color: var(--nasa-mute); }

/* search box */
#searchbox form.search { display: flex; gap: 0.4rem; }

.nasa-margin input[type="text"],
.nasa-margin input[type="search"] {
  flex: 1 1 auto;
  min-width: 0;
  padding: 0.4rem 0.5rem;
  border: 1px solid var(--nasa-hairline);
  border-radius: 0;
  background: var(--nasa-bg);
  color: var(--nasa-ink);
  font-family: inherit;
  font-size: 0.85rem;
}

.nasa-margin input[type="submit"] {
  padding: 0.4rem 0.7rem;
  border: 0;
  border-radius: 0;
  background: var(--nasa-red);
  color: #fff;
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
}

/* nav toggle, small screens only */
.nasa-nav-toggle { display: none; }
.nasa-nav-button { display: none; }

/* ---------- headings ---------- */

h1, h2, h3, h4, h5, h6 {
  color: var(--nasa-text);
  font-weight: 700;
  line-height: 1.18;
  text-align: left;
}

h1 {
  margin: 0 0 1.5rem;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid var(--nasa-rule);
  font-size: 2.1rem;
  letter-spacing: -0.012em;
}

h2 {
  margin: 2.75rem 0 0.9rem;
  padding-bottom: 0.45rem;
  border-bottom: 1px solid var(--nasa-hairline);
  font-size: 1.4rem;
}

h3 { margin: 2rem 0 0.6rem; font-size: 1.1rem; }
h4 { margin: 1.6rem 0 0.5rem; font-size: 0.95rem; }
h5, h6 {
  margin: 1.4rem 0 0.4rem;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--nasa-mute);
}

.headerlink {
  margin-left: 0.4rem;
  color: var(--nasa-hairline);
  text-decoration: none;
  border: 0;
  opacity: 0;
  transition: opacity 0.12s;
}
h1:hover .headerlink, h2:hover .headerlink, h3:hover .headerlink,
h4:hover .headerlink, h5:hover .headerlink, h6:hover .headerlink,
dt:hover > .headerlink { opacity: 1; }
.headerlink:hover { color: var(--nasa-red); }

p.subtitle {
  margin: -1rem 0 1.5rem;
  font-size: 1.05rem;
  color: var(--nasa-mute);
}

/* ---------- body copy ---------- */

p { margin: 0 0 1.1rem; }

a {
  color: var(--nasa-text);
  text-decoration: none;
  border-bottom: 1px solid var(--nasa-red);
}
a:hover { color: var(--nasa-red); }
a.external::after { content: "\2197"; font-size: 0.8em; margin-left: 0.15em; }

ul, ol { margin: 0 0 1.1rem; padding-left: 1.15rem; }
li { margin: 0 0 0.3rem; }
li > ul, li > ol { margin-top: 0.3rem; }

blockquote {
  margin: 1.4rem 0;
  padding-left: 1.1rem;
  border-left: 2px solid var(--nasa-red);
  color: var(--nasa-ink);
}

hr, .docutils.horizontal-rule {
  margin: 2.5rem 0;
  border: 0;
  border-top: 1px solid var(--nasa-rule);
}

/* ---------- code ---------- */

code, tt, kbd, pre, .literal {
  font-family: var(--nasa-mono);
  font-size: 0.86em;
}

code.literal, .literal {
  padding: 0.1em 0.32em;
  background: var(--nasa-paper);
  border: 1px solid var(--nasa-hairline);
  border-radius: 0;
  color: var(--nasa-text);
}
a code.literal, a .literal { color: inherit; }

div[class^="highlight-"] {
  margin: 0 0 1.3rem;
  background: var(--nasa-paper);
  border: 1px solid var(--nasa-hairline);
  border-radius: 0;
}

/* inner wrapper must not repeat the frame */
div[class^="highlight-"] .highlight {
  margin: 0;
  background: transparent;
  border: 0;
}

div[class^="highlight-"] pre {
  margin: 0;
  padding: 1rem 1.1rem;
  overflow-x: auto;
  line-height: 1.55;
  background: transparent;
}

.literal-block-wrapper { margin-bottom: 1.3rem; }

.code-block-caption {
  margin: 0;
  padding: 0.5rem 1.1rem;
  background: var(--nasa-paper);
  border: 1px solid var(--nasa-hairline);
  border-bottom: 0;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--nasa-mute);
}
.literal-block-wrapper div[class^="highlight-"] { margin: 0; }

/* line numbers */
table.highlighttable { width: 100%; border: 0; margin: 0; }
table.highlighttable td { border: 0; padding: 0; }
td.linenos { width: 1%; }
.linenos pre { color: var(--nasa-mute); }

/* ---------- admonitions ---------- */

.admonition, div.topic, .sidebar {
  margin: 1.5rem 0;
  padding: 0;
  background: var(--nasa-bg);
  border: 1px solid var(--nasa-hairline);
  border-radius: 0;
  font-size: 0.95rem;
}

.admonition > .admonition-title,
div.topic > .topic-title,
.sidebar > .sidebar-title {
  margin: 0;
  padding: 0.45rem 1.1rem;
  background: var(--nasa-gray);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.admonition > *:not(.admonition-title),
div.topic > *:not(.topic-title) {
  margin-left: 1.1rem;
  margin-right: 1.1rem;
}
.admonition > *:nth-child(2),
div.topic > *:nth-child(2) { margin-top: 0.9rem; }
.admonition > *:last-child,
div.topic > *:last-child { margin-bottom: 0.9rem; }

/* Red is the restricted second colour: only genuine warnings earn it. */
.admonition.warning > .admonition-title,
.admonition.danger > .admonition-title,
.admonition.error > .admonition-title,
.admonition.caution > .admonition-title,
.admonition.attention > .admonition-title {
  background: var(--nasa-red);
}

.admonition.note > .admonition-title,
.admonition.important > .admonition-title,
.admonition.hint > .admonition-title,
.admonition.tip > .admonition-title,
.admonition.seealso > .admonition-title {
  background: var(--nasa-text);
  color: var(--nasa-bg);
}

.versionadded, .versionchanged, .deprecated {
  margin: 1.3rem 0;
  padding-left: 1rem;
  border-left: 2px solid var(--nasa-gray);
  font-size: 0.95rem;
}

/* ---------- tables ---------- */

table.docutils {
  width: 100%;
  margin: 0 0 1.5rem;
  border-collapse: collapse;
  border: 0;
  border-top: 1px solid var(--nasa-rule);
  border-bottom: 1px solid var(--nasa-rule);
  font-size: 0.93rem;
}

table.docutils th {
  padding: 0.5rem 0.7rem 0.5rem 0;
  border: 0;
  border-bottom: 1px solid var(--nasa-rule);
  background: none;
  text-align: left;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--nasa-text);
  vertical-align: bottom;
}

table.docutils td {
  padding: 0.5rem 0.7rem 0.5rem 0;
  border: 0;
  border-bottom: 1px solid var(--nasa-hairline);
  vertical-align: top;
}

table.docutils tr:last-child td { border-bottom: 0; }
table.docutils th:last-child, table.docutils td:last-child { padding-right: 0; }

.table-wrapper { overflow-x: auto; }

/* ---------- api / definition lists ---------- */

dl.py, dl.c, dl.cpp, dl.js, dl.rst, dl.std {
  margin: 1.5rem 0;
}

dl.py > dt, dl.c > dt, dl.cpp > dt, dl.js > dt, dl.rst > dt, dl.std > dt {
  padding: 0.5rem 0.75rem;
  background: var(--nasa-paper);
  border-left: 2px solid var(--nasa-red);
  font-family: var(--nasa-mono);
  font-size: 0.88rem;
  font-weight: 400;
}

dl.py > dd, dl.c > dd, dl.cpp > dd, dl.js > dd, dl.rst > dd, dl.std > dd {
  margin: 0.9rem 0 0 0.75rem;
}

.sig-name, .sig-prename { font-weight: 700; }
.sig-param { font-style: normal; }
em.property { color: var(--nasa-mute); font-style: normal; }

dl.field-list > dt {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--nasa-mute);
}
dl.field-list > dd { margin: 0.2rem 0 0.9rem; }

/* ---------- toctree on landing pages ---------- */

.toctree-wrapper ul { list-style: none; padding-left: 0; }
.toctree-wrapper > ul > li {
  padding: 0.55rem 0;
  border-bottom: 1px solid var(--nasa-hairline);
}
.toctree-wrapper > ul > li > a { font-weight: 700; border-bottom: 0; }
.toctree-wrapper ul ul { padding-left: 1.1rem; margin-top: 0.3rem; }
.toctree-wrapper ul ul a { color: var(--nasa-mute); border-bottom: 0; }
.toctree-wrapper ul ul a:hover { color: var(--nasa-red); }

/* ---------- figures ---------- */

figure, div.figure { margin: 1.75rem 0; }
figcaption, .caption {
  margin-top: 0.5rem;
  font-size: 0.82rem;
  color: var(--nasa-mute);
}
figcaption .caption-number, .caption .caption-number {
  font-weight: 700;
  color: var(--nasa-text);
}

/* ---------- sequence nav ---------- */

.nasa-seq {
  display: flex;
  gap: 1.5rem;
  margin-top: 4rem;
  padding-top: 1.1rem;
  border-top: 1px solid var(--nasa-rule);
}

.nasa-seq a {
  flex: 1 1 0;
  border: 0;
  text-decoration: none;
  color: var(--nasa-text);
}
.nasa-seq-next { text-align: right; }

.nasa-seq-label {
  display: block;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--nasa-mute);
}

.nasa-seq-title { display: block; font-weight: 700; }
.nasa-seq a:hover .nasa-seq-title { color: var(--nasa-red); }

/* ---------- footer ---------- */

.nasa-footer {
  border-top: 1px solid var(--nasa-rule);
  background: var(--nasa-bg);
}

.nasa-footer-inner {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 2rem;
  justify-content: space-between;
  max-width: calc(var(--nasa-margin-col) + var(--nasa-gutter) + var(--nasa-measure) + var(--nasa-pad));
  margin: 0 auto;
  padding: 1.2rem var(--nasa-pad) 2.5rem;
  font-size: 0.76rem;
  color: var(--nasa-mute);
}

.nasa-footer p { margin: 0; }
.nasa-footer-doc { font-weight: 700; color: var(--nasa-text); }
.nasa-footer-rev { margin-left: 0.9rem; font-weight: 400; color: var(--nasa-mute); }
.nasa-footer-meta span { margin-left: 0.9rem; }

/* ---------- search results ---------- */

ul.search { list-style: none; padding: 0; }
ul.search li {
  padding: 0.8rem 0;
  border-bottom: 1px solid var(--nasa-hairline);
}
ul.search li a { font-weight: 700; }
.context { color: var(--nasa-mute); font-size: 0.9rem; }
.highlighted { background: var(--nasa-red); color: #fff; padding: 0 0.15em; }

/* ---------- responsive ---------- */

@media (max-width: 820px) {
  :root { --nasa-pad: 1.25rem; }

  .nasa-page {
    display: block;
    padding-bottom: 3rem;
  }

  .nasa-nav-button {
    display: inline-block;
    margin: 1.25rem 0 0;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--nasa-rule);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
  }

  .nasa-margin {
    display: none;
    position: static;
    max-height: none;
    padding-top: 1.5rem;
    overflow: visible;
  }

  .nasa-nav-toggle:checked ~ .nasa-margin { display: block; }
  .nasa-nav-toggle:checked ~ .nasa-nav-button {
    background: var(--nasa-text);
    color: var(--nasa-bg);
  }

  .nasa-body { padding-top: 1.75rem; }
  h1 { font-size: 1.65rem; }
  h2 { font-size: 1.2rem; }
  .nasa-seq { flex-direction: column; gap: 1.1rem; }
  .nasa-seq-next { text-align: left; }
}

@media print {
  .nasa-margin, .nasa-seq, .nasa-nav-button, .skip-link { display: none; }
  body { font-size: 10.5pt; }
  .nasa-page { display: block; max-width: none; padding: 0; }
  a { border-bottom: 0; }
}
